model Post {
    id         String     @id @default(uuid())
    title      String     @db.VarChar(255)
    content    String
    thumbnail  String?
    isFeatured Boolean    @default(false)
    status     PostStatus @default(published)
    tags       String[]
    views      Int        @default(0)
    authorId   String
    comments   Comment[]
    createdAt  DateTime   @default(now())
    updatedAt  DateTime   @updatedAt

    @@index([authorId])
}

enum PostStatus {
    darft
    published
    archive
}
